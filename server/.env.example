# Copy this file to .env and adjust.

# development | production | test
NODE_ENV=development

# The client dev server proxies /api to this port (see client/vite.config.ts).
PORT=4000

# Address of the website, allowed to call the API (CORS). In production use the real domain.
CLIENT_ORIGIN=http://localhost:5173

# Folder of the JSON database files, relative to the server folder.
DATA_DIR=data
